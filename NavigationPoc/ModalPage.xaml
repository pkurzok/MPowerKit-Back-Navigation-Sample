<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:NavigationPoc"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="local:ModalViewModel"
             x:Class="NavigationPoc.ModalPage"
             BackgroundColor="{Binding BackgroundColor}">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior x:Name="StatusBarBehavior"
                                   
                                   StatusBarColor="{Binding BackgroundColor}"
                                   StatusBarStyle="DarkContent" />
    </ContentPage.Behaviors>
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout
                Padding="30,0"
                Spacing="25">
               
                <Label
                    Text="I'm a Modal Page"
                    Style="{StaticResource Headline}"
                    SemanticProperties.HeadingLevel="Level1" />
              
                <Button
                    Text="Go Back" 
                    Command="{Binding GoBackCommand}"
                    HorizontalOptions="Fill" />
                
                <Button
                    Text="Go Pink" 
                    Command="{Binding GoPinkCommand}"
                    HorizontalOptions="Fill" />
            
            </VerticalStackLayout>
        </ScrollView>
        
        
    </ContentPage.Content>
</ContentPage>